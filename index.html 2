<!-- TOAST -->

<div
    class="toast"
    id="toast">
</div>


<script>

/* =====================================================
   ACCOUNT SYSTEM
===================================================== */

let authMode = "login";

let currentUser =
    localStorage.getItem("tfilmsCurrentUser") || null;

let users =
    JSON.parse(
        localStorage.getItem("tfilmsUsers") || "{}"
    );


function openAccount(){

    if(currentUser){

        const logout =
            confirm(
                "Du bist als " +
                currentUser +
                " angemeldet.\n\nMöchtest du dich abmelden?"
            );

        if(logout){
            currentUser = null;
            localStorage.removeItem("tfilmsCurrentUser");
            updateUI();
            showToast("Du wurdest abgemeldet.");
        }

        return;
    }

    document
        .getElementById("accountModal")
        .classList.remove("hidden");

}


function closeAccount(){

    document
        .getElementById("accountModal")
        .classList.add("hidden");

}


function toggleAuth(){

    authMode =
        authMode === "login"
            ? "register"
            : "login";


    document.getElementById("modalTitle").textContent =
        authMode === "login"
            ? "Anmelden"
            : "Konto erstellen";


    document.getElementById("modalDescription").textContent =
        authMode === "login"
            ? "Melde dich an, um dein T-Points-Konto zu verwenden."
            : "Erstelle dein kostenloses T-Films-Konto und erhalte 500 T-Points.";


    document.getElementById("submitText").textContent =
        authMode === "login"
            ? "Anmelden"
            : "Registrieren";


    document.getElementById("switchText").textContent =
        authMode === "login"
            ? "Noch kein Konto?"
            : "Du hast bereits ein Konto?";


    document.getElementById("switchButton").textContent =
        authMode === "login"
            ? "Registrieren"
            : "Anmelden";

}


function handleAuth(event){

    event.preventDefault();


    const username =
        document
            .getElementById("username")
            .value
            .trim();


    const email =
        document
            .getElementById("email")
            .value
            .trim()
            .toLowerCase();


    const password =
        document
            .getElementById("password")
            .value;


    if(authMode === "register"){

        if(users[email]){

            showToast(
                "❌ Diese E-Mail ist bereits registriert."
            );

            return;
        }


        users[email] = {

            username:username,

            email:email,

            password:password,

            points:500,

            created:
                Date.now(),

            siteSeconds:0,

            twoHourReward:false,

            videoClicks:0,

            videoDay:
                getToday()

        };


        saveUsers();


        currentUser = email;

        localStorage.setItem(
            "tfilmsCurrentUser",
            email
        );


        closeAccount();

        updateUI();

        showToast(
            "🎁 Willkommen bei T-Films! +500 T-Points!"
        );


    }else{

        if(!users[email] ||
           users[email].password !== password){

            showToast(
                "❌ E-Mail oder Passwort falsch."
            );

            return;
        }


        currentUser = email;

        localStorage.setItem(
            "tfilmsCurrentUser",
            email
        );


        closeAccount();

        updateUI();

        showToast(
            "👋 Willkommen zurück!"
        );

    }

}


/* =====================================================
   USER DATA
===================================================== */

function getUser(){

    if(!currentUser)
        return null;

    return users[currentUser];

}


function saveUsers(){

    localStorage.setItem(
        "tfilmsUsers",
        JSON.stringify(users)
    );

}


function getToday(){

    const now =
        new Date();

    return now.getFullYear()
        + "-"
        + String(now.getMonth()+1).padStart(2,"0")
        + "-"
        + String(now.getDate()).padStart(2,"0");

}


/* =====================================================
   POINTS
===================================================== */

function updateUI(){

    const user =
        getUser();


    if(!user){

        document.getElementById("navPoints").textContent =
            "0";

        document.getElementById("points").textContent =
            "0";

        document.getElementById("profileName").textContent =
            "Nicht angemeldet";

        document.getElementById("avatar").textContent =
            "?";

        document.getElementById("accountButton").textContent =
            "Anmelden";

        return;
    }


    document.getElementById("navPoints").textContent =
        user.points.toLocaleString("de-DE");


    document.getElementById("points").textContent =
        user.points.toLocaleString("de-DE");


    document.getElementById("profileName").textContent =
        user.username;


    document.getElementById("avatar").textContent =
        user.username
            .substring(0,2)
            .toUpperCase();


    document.getElementById("accountButton").textContent =
        "👤 " + user.username;


    updateRank(user.points);


    updateVideoLimit(user);


    updateSiteTime(user);

}


function updateRank(points){

    let rank;
    let progress;


    if(points >= 50000){

        rank =
            "👑 Wächter der Finsternis";

        progress = 100;

    }else if(points >= 25000){

        rank =
            "👁️ Hüter der Finsternis";

        progress =
            points / 50000 * 100;

    }else if(points >= 15000){

        rank =
            "🔥 Schattenkrieger";

        progress =
            points / 25000 * 100;

    }else if(points >= 5000){

        rank =
            "🗡️ Schattenjäger";

        progress =
            points / 15000 * 100;

    }else{

        rank =
            "🌑 Schatten-Neuling";

        progress =
            points / 5000 * 100;

    }


    document.getElementById("rank").textContent =
        rank;


    document.getElementById("progressBar").style.width =
        Math.min(progress,100) + "%";

}


/* =====================================================
   VIDEO CLICK LIMIT
===================================================== */

function updateVideoLimit(user){

    resetVideoDayIfNeeded(user);

    document.getElementById("videoClicks").textContent =
        user.videoClicks;

}


function resetVideoDayIfNeeded(user){

    const today =
        getToday();


    if(user.videoDay !== today){

        user.videoDay =
            today;

        user.videoClicks =
            0;

        saveUsers();

    }

}


/*
   MAXIMAL 10 Video-Klicks pro Tag
*/

function watchVideo(url){

    const user =
        getUser();


    if(!user){

        showToast(
            "🔒 Bitte zuerst ein kostenloses Konto erstellen."
        );

        openAccount();

        return;
    }


    resetVideoDayIfNeeded(user);


    if(user.videoClicks >= 10){

        showToast(
            "🚫 Tageslimit erreicht. Du kannst heute keine weiteren Videos für T-Points öffnen."
        );

        return;
    }


    user.videoClicks++;

    user.points += 100;


    saveUsers();

    updateUI();


    showToast(
        "🎬 +100 T-Points! " +
        user.videoClicks +
        "/10 Video-Klicks heute."
    );


    window.open(
        url,
        "_blank"
    );

}


/* =====================================================
   2 STUNDEN AUF DER WEBSITE
===================================================== */

let lastActivity =
    Date.now();


function trackTime(){

    const user =
        getUser();


    if(!user)
        return;


    const now =
        Date.now();


    const difference =
        Math.floor(
            (now - lastActivity) / 1000
        );


    /*
       Schutz gegen riesige Zeit-Sprünge.
       Maximal 10 Sekunden pro Tracking-Intervall.
    */

    if(difference > 0 && difference <= 10){

        user.siteSeconds +=
            difference;

    }


    lastActivity =
        now;


    /*
       2 Stunden = 7200 Sekunden
    */

    if(
        user.siteSeconds >= 7200 &&
        !user.twoHourReward
    ){

        user.twoHourReward =
            true;

        user.points += 200;

        showToast(
            "⏱️ 2 Stunden erreicht! +200 T-Points!"
        );

    }


    saveUsers();

    updateUI();

}


setInterval(
    trackTime,
    5000
);


/* =====================================================
   WEBSITE ZEIT ANZEIGE
===================================================== */

function updateSiteTime(user){

    let seconds =
        user.siteSeconds;


    const hours =
        Math.floor(
            seconds / 3600
        );


    seconds %= 3600;


    const minutes =
        Math.floor(
            seconds / 60
        );


    seconds %= 60;


    document.getElementById("siteTime").textContent =
        String(hours).padStart(2,"0")
        + ":"
        + String(minutes).padStart(2,"0")
        + ":"
        + String(seconds).padStart(2,"0");

}


/* =====================================================
   REWARDS
===================================================== */

function redeem(cost,reward){

    const user =
        getUser();


    if(!user){

        showToast(
            "🔒 Bitte zuerst anmelden."
        );

        openAccount();

        return;
    }


    if(user.points < cost){

        showToast(
            "❌ Dir fehlen noch " +
            (cost-user.points)
                .toLocaleString("de-DE") +
            " T-Points."
        );

        return;

    }


    user.points -= cost;


    saveUsers();

    updateUI();


    showToast(
        "🎁 " +
        reward +
        " erfolgreich eingelöst!"
    );


    setTimeout(() => {

        alert(
`🎁 Belohnung eingelöst!

Belohnung:
${reward}

Mach bitte einen Screenshot dieser Einlösung.

Schicke den Screenshot anschließend an T-Films über TikTok:

@tfilms2025

Bitte gib dabei deinen T-Films-Benutzernamen an.

TikTok:
https://www.tiktok.com/@tfilms2025`
        );

    },400);

}


/* =====================================================
   COUNTDOWN
===================================================== */

const releaseDate =
    new Date(
        "October 31, 2026 18:00:00"
    ).getTime();


function countdown(){

    const now =
        Date.now();


    const distance =
        releaseDate - now;


    if(distance <= 0){

        document.getElementById("days").textContent =
            "0";

        document.getElementById("hours").textContent =
            "0";

        document.getElementById("minutes").textContent =
            "0";

        document.getElementById("seconds").textContent =
            "0";

        return;
    }


    document.getElementById("days").textContent =
        Math.floor(
            distance /
            (1000*60*60*24)
        );


    document.getElementById("hours").textContent =
        Math.floor(
            distance %
            (1000*60*60*24) /
            (1000*60*60)
        );


    document.getElementById("minutes").textContent =
        Math.floor(
            distance %
            (1000*60*60) /
            (1000*60)
        );


    document.getElementById("seconds").textContent =
        Math.floor(
            distance %
            (1000*60) /
            1000
        );

}


setInterval(
    countdown,
    1000
);


/* =====================================================
   TOAST
===================================================== */

function showToast(message){

    const toast =
        document.getElementById("toast");


    toast.textContent =
        message;


    toast.classList.add("show");


    setTimeout(() => {

        toast.classList.remove("show");

    },3500);

}


/* =====================================================
   INITIALIZATION
===================================================== */

updateUI();

countdown();


/*
   Bei Rückkehr auf die Website
   wird die Zeitmessung fortgesetzt.
*/

document.addEventListener(
    "visibilitychange",
    () => {

        lastActivity =
            Date.now();

    }
);


/*
   Navbar beim Scrollen etwas stärker abdunkeln.
*/

window.addEventListener(
    "scroll",
    () => {

        const nav =
            document.querySelector(".navbar");


        if(window.scrollY > 50){

            nav.style.background =
                "rgba(3,3,3,.95)";

        }else{

            nav.style.background =
                "rgba(3,3,3,.78)";

        }

    }
);

</script>

