<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#030303">

<title>Schatten der Finsternis | T-Films Offiziell</title>

<style>
@import url('https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600;700;800&family=Inter:wght@300;400;500;600;700;800&display=swap');

:root{
    --bg:#030303;
    --bg2:#080808;
    --card:#111111;
    --line:rgba(255,255,255,.09);
    --text:#f4f4f4;
    --muted:#8c8c8c;
    --purple:#8d5cff;
    --purple2:#5c2cff;
    --gold:#d9b45a;
    --green:#54d98c;
}

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

html{
    scroll-behavior:smooth;
}

body{
    background:
        radial-gradient(circle at 80% 0%,rgba(105,45,200,.14),transparent 30%),
        radial-gradient(circle at 0% 70%,rgba(110,25,160,.08),transparent 35%),
        var(--bg);
    color:var(--text);
    font-family:Inter,sans-serif;
    overflow-x:hidden;
}

a{
    text-decoration:none;
    color:inherit;
}

button{
    font-family:inherit;
}

.hidden{
    display:none!important;
}

/* NAV */

.navbar{
    position:fixed;
    z-index:1000;
    top:0;
    left:0;
    width:100%;
    height:74px;
    padding:0 6%;
    display:flex;
    align-items:center;
    justify-content:space-between;
    background:rgba(3,3,3,.78);
    backdrop-filter:blur(18px);
    border-bottom:1px solid var(--line);
}

.logo{
    font-family:Cinzel,serif;
    font-weight:800;
    letter-spacing:2px;
}

.logo span{
    color:var(--purple);
}

.nav-links{
    display:flex;
    gap:28px;
    list-style:none;
}

.nav-links a{
    color:#aaa;
    font-size:13px;
    transition:.2s;
}

.nav-links a:hover{
    color:white;
}

.account-area{
    display:flex;
    align-items:center;
    gap:10px;
}

.points-pill{
    padding:9px 14px;
    border-radius:999px;
    border:1px solid rgba(141,92,255,.35);
    background:rgba(141,92,255,.08);
    font-size:12px;
}

.account-btn{
    border:1px solid var(--line);
    background:rgba(255,255,255,.06);
    color:white;
    padding:9px 14px;
    border-radius:8px;
    cursor:pointer;
}

/* HERO */

.hero{
    min-height:90vh;
    padding:150px 7% 100px;
    display:flex;
    align-items:center;
    position:relative;
    overflow:hidden;
}

.hero:before{
    content:"";
    position:absolute;
    inset:0;
    background:
        linear-gradient(90deg,#030303 0%,rgba(3,3,3,.92) 35%,rgba(3,3,3,.5) 75%,#030303 100%);
}

.hero:after{
    content:"";
    position:absolute;
    right:-150px;
    top:100px;
    width:650px;
    height:650px;
    border-radius:50%;
    background:rgba(120,50,220,.13);
    filter:blur(110px);
}

.hero-content{
    position:relative;
    z-index:2;
    max-width:800px;
}

.eyebrow{
    color:#b493ff;
    text-transform:uppercase;
    letter-spacing:4px;
    font-size:12px;
    font-weight:800;
    margin-bottom:18px;
}

.hero h1{
    font-family:Cinzel,serif;
    font-size:clamp(48px,8vw,94px);
    line-height:.95;
    letter-spacing:-2px;
}

.hero h1 span{
    display:block;
    color:#aaa;
    font-size:.4em;
    letter-spacing:5px;
    margin-top:18px;
}

.hero p{
    margin-top:28px;
    max-width:650px;
    color:#aaa;
    line-height:1.8;
}

.hero-buttons{
    margin-top:30px;
    display:flex;
    gap:12px;
    flex-wrap:wrap;
}

.btn{
    border:0;
    padding:14px 21px;
    border-radius:9px;
    cursor:pointer;
    font-weight:700;
    transition:.25s;
}

.btn:hover{
    transform:translateY(-2px);
}

.primary{
    background:white;
    color:black;
}

.secondary{
    background:rgba(255,255,255,.06);
    color:white;
    border:1px solid var(--line);
}

/* SECTIONS */

section{
    padding:90px 7%;
}

.section-title{
    font-family:Cinzel,serif;
    font-size:34px;
    margin-bottom:10px;
}

.section-subtitle{
    color:var(--muted);
    margin-bottom:38px;
}

/* FILMS */

.film-grid{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(280px,1fr));
    gap:22px;
}

.film-card{
    background:linear-gradient(145deg,#171717,#080808);
    border:1px solid var(--line);
    border-radius:18px;
    overflow:hidden;
    transition:.3s;
}

.film-card:hover{
    transform:translateY(-6px);
    border-color:rgba(141,92,255,.4);
}

.poster{
    height:205px;
    display:flex;
    align-items:center;
    justify-content:center;
    text-align:center;
    background:
        radial-gradient(circle,rgba(130,60,210,.3),transparent 55%),
        linear-gradient(145deg,#1b1023,#050505);
}

.poster small{
    color:#999;
    letter-spacing:3px;
}

.poster strong{
    display:block;
    font-family:Cinzel,serif;
    font-size:24px;
    margin-top:8px;
}

.film-info{
    padding:22px;
}

.film-info h3{
    font-size:17px;
}

.film-info p{
    color:#888;
    font-size:13px;
    line-height:1.6;
    margin-top:9px;
}

.meta{
    display:flex;
    gap:7px;
    flex-wrap:wrap;
    margin:15px 0;
}

.meta span{
    border:1px solid var(--line);
    padding:5px 7px;
    border-radius:5px;
    color:#aaa;
    font-size:10px;
}

.watch-btn{
    width:100%;
    border:1px solid rgba(141,92,255,.3);
    background:rgba(141,92,255,.08);
    color:#c7afff;
    padding:12px;
    border-radius:8px;
    cursor:pointer;
    font-weight:700;
}

.watch-btn:hover{
    background:rgba(141,92,255,.16);
}

/* UPCOMING */

.timeline{
    max-width:900px;
    margin:auto;
    position:relative;
}

.timeline:before{
    content:"";
    position:absolute;
    left:19px;
    top:0;
    bottom:0;
    width:1px;
    background:linear-gradient(var(--purple),transparent);
}

.release{
    position:relative;
    padding-left:62px;
    margin-bottom:28px;
}

.release-dot{
    position:absolute;
    left:10px;
    top:7px;
    width:19px;
    height:19px;
    background:var(--purple);
    border-radius:50%;
    box-shadow:0 0 25px rgba(141,92,255,.7);
}

.release-card{
    background:var(--card);
    border:1px solid var(--line);
    padding:23px;
    border-radius:15px;
}

.release-date{
    color:#b99dff;
    font-size:11px;
    letter-spacing:2px;
    font-weight:800;
}

.release-card h3{
    font-family:Cinzel,serif;
    font-size:22px;
    margin:8px 0;
}

.release-card p{
    color:#888;
    font-size:13px;
}

/* COUNTDOWN */

.countdown-box{
    margin-top:45px;
    text-align:center;
    padding:35px;
    border-radius:20px;
    border:1px solid rgba(141,92,255,.3);
    background:radial-gradient(circle,rgba(141,92,255,.1),transparent 60%),#080808;
}

.countdown{
    display:flex;
    justify-content:center;
    gap:12px;
    flex-wrap:wrap;
    margin-top:22px;
}

.time{
    min-width:85px;
    padding:16px;
    border-radius:10px;
    background:rgba(255,255,255,.04);
    border:1px solid var(--line);
}

.time strong{
    display:block;
    font-size:28px;
}

.time span{
    font-size:9px;
    color:#777;
    letter-spacing:2px;
}

/* POINTS */

.points-section{
    background:#060606;
}

.dashboard{
    display:grid;
    grid-template-columns:1.2fr .8fr;
    gap:22px;
}

.panel{
    background:var(--card);
    border:1px solid var(--line);
    border-radius:18px;
    padding:28px;
}

.profile{
    display:flex;
    align-items:center;
    gap:16px;
}

.avatar{
    width:58px;
    height:58px;
    border-radius:50%;
    display:grid;
    place-items:center;
    background:linear-gradient(135deg,#8055ff,#241144);
    font-weight:800;
}

.profile p{
    color:#777;
    font-size:12px;
    margin-top:3px;
}

.points-number{
    font-size:48px;
    font-weight:800;
    margin-top:28px;
}

.points-label{
    color:var(--gold);
    font-size:12px;
}

.progress{
    height:7px;
    background:#222;
    border-radius:10px;
    overflow:hidden;
    margin-top:20px;
}

.progress-bar{
    height:100%;
    width:0%;
    background:linear-gradient(90deg,var(--purple2),#c79dff);
    transition:.4s;
}

.rank{
    margin-top:10px;
    color:#b89cff;
    font-weight:700;
}

.video-limit{
    margin-top:22px;
    padding:15px;
    border-radius:10px;
    background:rgba(255,255,255,.035);
    border:1px solid var(--line);
    color:#aaa;
    font-size:12px;
}

.video-limit strong{
    color:white;
}

/* REWARDS */

.rewards{
    display:grid;
    gap:11px;
    margin-top:20px;
}

.reward{
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:15px;
    padding:14px;
    border-radius:10px;
    background:rgba(255,255,255,.035);
    border:1px solid var(--line);
}

.reward small{
    color:#777;
}

.reward button{
    background:rgba(141,92,255,.1);
    color:#c4a9ff;
    border:1px solid rgba(141,92,255,.3);
    padding:7px 10px;
    border-radius:6px;
    cursor:pointer;
}

/* CONTACT */

.contact-box{
    max-width:800px;
    margin:auto;
    text-align:center;
    padding:45px 25px;
    border:1px solid var(--line);
    border-radius:20px;
    background:linear-gradient(145deg,rgba(141,92,255,.08),rgba(255,255,255,.02));
}

.socials{
    display:flex;
    justify-content:center;
    gap:12px;
    flex-wrap:wrap;
    margin-top:25px;
}

.social{
    padding:13px 18px;
    border-radius:9px;
    border:1px solid var(--line);
    background:rgba(255,255,255,.05);
    font-weight:700;
}

.social:hover{
    border-color:var(--purple);
}

/* LORE */

.lore-box{
    max-width:900px;
    padding:32px;
    border:1px solid var(--line);
    border-radius:18px;
    background:var(--card);
    color:#aaa;
    line-height:1.9;
}

/* FOOTER */

footer{
    text-align:center;
    padding:45px 7%;
    color:#666;
    border-top:1px solid var(--line);
    font-size:12px;
}

/* MODAL */

.modal{
    position:fixed;
    z-index:3000;
    inset:0;
    display:flex;
    align-items:center;
    justify-content:center;
    padding:20px;
    background:rgba(0,0,0,.8);
    backdrop-filter:blur(10px);
}

.modal-box{
    width:100%;
    max-width:430px;
    background:#101010;
    border:1px solid var(--line);
    border-radius:18px;
    padding:28px;
    box-shadow:0 30px 100px rgba(0,0,0,.8);
}

.modal-box h2{
    font-family:Cinzel,serif;
    margin-bottom:8px;
}

.modal-box p{
    color:#777;
    font-size:13px;
    line-height:1.6;
}

.form{
    margin-top:20px;
}

.form input{
    width:100%;
    padding:13px;
    margin-bottom:10px;
    background:#080808;
    border:1px solid var(--line);
    color:white;
    border-radius:8px;
    outline:none;
}

.form input:focus{
    border-color:var(--purple);
}

.form button{
    width:100%;
    padding:13px;
    border:0;
    border-radius:8px;
    background:white;
    color:black;
    font-weight:800;
    cursor:pointer;
}

.switch{
    margin-top:15px;
    text-align:center;
    color:#999;
    font-size:12px;
}

.switch span{
    color:#b797ff;
    cursor:pointer;
}

.close{
    float:right;
    border:0;
    background:none;
    color:#777;
    font-size:20px;
    cursor:pointer;
}

/* TOAST */

.toast{
    position:fixed;
    z-index:4000;
    bottom:25px;
    right:25px;
    max-width:350px;
    padding:15px 18px;
    border-radius:10px;
    background:#151515;
    border:1px solid rgba(141,92,255,.4);
    box-shadow:0 20px 60px rgba(0,0,0,.6);
    transform:translateY(120px);
    opacity:0;
    transition:.35s;
}

.toast.show{
    transform:translateY(0);
    opacity:1;
}

/* MOBILE */

@media(max-width:800px){

    .navbar{
        padding:0 5%;
    }

    .nav-links{
        display:none;
    }

    .hero{
        padding-left:6%;
        padding-right:6%;
    }

    .hero h1{
        font-size:50px;
    }

    section{
        padding:70px 6%;
    }

    .dashboard{
        grid-template-columns:1fr;
    }

    .points-number{
        font-size:40px;
    }

    .time{
        min-width:70px;
    }

    .time strong{
        font-size:22px;
    }

    .toast{
        left:20px;
        right:20px;
        bottom:20px;
    }
}
</style>
</head>

