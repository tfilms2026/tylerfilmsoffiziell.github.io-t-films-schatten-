            Melde dich an, um dein T-Points-Konto zu verwenden.
        </p>


        <form
            class="form"
            onsubmit="handleAuth(event)">

            <input
                id="username"
                type="text"
                placeholder="Benutzername"
                required>

            <input
                id="email"
                type="email"
                placeholder="E-Mail-Adresse"
                required>

            <input
                id="password"
                type="password"
                placeholder="Passwort"
                required
                minlength="4">


            <button type="submit">
                <span id="submitText">
                    Anmelden
                </span>
            </button>

        </form>


